# CodeSage environment configuration.
# Copy to `.env` and adjust:  cp .env.example .env
# The backend loads this file automatically when you run it from the terminal.
# Never commit the real `.env`.

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------
APP_NAME=CodeSage
# development | test | staging | production
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# console (readable, for local dev) | json (structured, for production/log shipping)
LOG_FORMAT=console

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL running on your machine)
# ---------------------------------------------------------------------------
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
# Create the user and database once - see README.md "One-time setup".
DATABASE_URL=postgresql+psycopg://codesage:codesage@localhost:5432/codesage
# Set to true to print every SQL statement (noisy; useful for debugging).
DATABASE_ECHO=false

# Optional: run the backend test suite against PostgreSQL instead of SQLite.
# Use a separate, disposable database - tests drop and recreate all tables.
# TEST_DATABASE_URL=postgresql+psycopg://codesage:codesage@localhost:5432/codesage_test

# ---------------------------------------------------------------------------
# Repository ingestion (all optional - these are the defaults)
# ---------------------------------------------------------------------------
# Where cloned repositories are stored (relative paths are relative to the repo
# root). Keep it outside backend/ so `uvicorn --reload` ignores clones.
# REPOSITORY_STORAGE_DIR=data/repositories

# Local repositories can be added only when APP_ENV is development/test, and only
# from inside these comma-separated directories (default: your home directory).
# ALLOW_LOCAL_REPOSITORIES=true
# LOCAL_REPOSITORY_ROOTS=~/projects,~/work

# Timeouts for `git ls-remote` (checking a URL) and `git clone`, in seconds.
# GIT_REMOTE_TIMEOUT_SECONDS=30
# GIT_CLONE_TIMEOUT_SECONDS=600

# Safety limits. Larger repositories fail indexing with a clear message.
# MAX_REPOSITORY_SIZE_MB=1024
# MAX_REPOSITORY_FILES=100000
# Files bigger than this are counted but not added to the file index.
# MAX_INDEXED_FILE_SIZE_KB=1024
# Source files bigger than this are indexed but not parsed into symbols.
# MAX_PARSED_FILE_SIZE_KB=512

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# thread = run jobs in a thread pool inside the backend process (default)
# inline = run jobs synchronously inside the request (debugging only)
# JOB_BACKEND=thread
# Maximum repositories indexed at the same time.
# JOB_WORKERS=2

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# The frontend does NOT read this file (Next.js only reads frontend/.env*).
# It defaults to http://localhost:8000/api/v1. To point it elsewhere, put this
# line in frontend/.env.local and restart `npm run dev`:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# Code retrieval (Phase 4) - all optional, these are the defaults
# ---------------------------------------------------------------------------
# Build the search index (chunks + BM25 + embeddings) as the last indexing stage.
# RETRIEVAL_ENABLED=true
# Where index files are written (relative paths are relative to the repo root).
# INDEX_STORAGE_DIR=data/indexes

# Chunking: whole functions/classes are kept intact; only bigger symbols are split.
# CHUNK_MAX_LINES=60
# CHUNK_MAX_CHARS=4000
# CHUNK_OVERLAP_LINES=8
# CHUNK_MIN_LINES=2

# BM25: k1 = term-frequency saturation, b = length normalisation (0-1).
# BM25_K1=1.2
# BM25_B=0.75

# Dense retrieval. fastembed downloads a local ONNX model on first use (~100 MB);
# hashing is an offline deterministic fallback used by the tests.
# DENSE_RETRIEVAL_ENABLED=true
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_THREADS=                       # blank = all cores
# EMBEDDING_MAX_CHARS=2000
# BGE recommends an instruction on the query side only; blank disables it.
# EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
# EMBEDDING_CACHE_DIR=data/models
# Chunks beyond this cap stay BM25-only (embedding is the slow part of indexing).
# MAX_EMBEDDED_CHUNKS=20000
# VECTOR_STORE=faiss

# Hybrid search: rrf = reciprocal rank fusion, weighted = normalised score fusion.
# HYBRID_FUSION=rrf
# HYBRID_BM25_WEIGHT=0.5
# HYBRID_DENSE_WEIGHT=0.5
# HYBRID_RRF_K=60
# HYBRID_CANDIDATES=50

# Reranking (used by the hybrid_rerank strategy). "none" disables it.
# RERANKER_PROVIDER=cross_encoder
# RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# RERANK_CANDIDATES=20
# RERANK_MAX_CHARS=1200

# Record every search (query, strategy, chunk ids, scores, latency) for research.
# A request can override this with "log": true/false.
# RETRIEVAL_LOGGING_ENABLED=true
